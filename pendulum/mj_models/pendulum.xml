<mujoco model="pendulum">
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.01"/>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <camera name="fixed" pos="0 -3 1" xyaxes="1 0 0 0 0 1"/>

    <body name="pivot" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0" frictionloss="0"/>
      <geom type="sphere" size="0.05" rgba="0.5 0.5 0.5 1"/>
      <body name="bob" pos="0 0 -1">
        <geom type="capsule" fromto="0 0 1 0 0 0" size="0.02" rgba="0.2 0.6 1 1"/>
        <geom type="sphere" size="0.08" pos="0 0 0" rgba="0.9 0.3 0.3 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>